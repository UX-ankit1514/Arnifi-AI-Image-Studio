# Copy to .env.local (never commit it). Only paths and settings go here — the key file itself stays outside the repo.

# ── Storage: Firestore (database + image files) ───────────────────────────────
FIREBASE_PROJECT_ID=arnifi-image-studio
# Service-account key downloaded from the Firebase console (Project settings → Service accounts).
GOOGLE_APPLICATION_CREDENTIALS=/Users/<you>/.config/arnifi-image-studio/firebase-sa.json

# ── AI image provider ────────────────────────────────────────────────────────
# codex  = your ChatGPT plan through the Codex app on this Mac (default)
# openai = OpenAI Image API with OPENAI_API_KEY (needed for hosting online)
IMAGE_PROVIDER=codex
# CODEX_MODEL=gpt-5.5
# CODEX_BASE_URL=   (optional: a different Codex backend)
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# OPENAI_EDIT_MODEL=gpt-image-2.5-sunburst

# ── Usage safeguards (PRD §21.2) ─────────────────────────────────────────────
# MAX_IMAGE_REQUESTS_PER_DAY=40
# MAX_REQUESTS_PER_SESSION_PER_HOUR=15
# MAX_OUTPUTS_PER_REQUEST=1

# ── Optional passcode in front of the whole app ──────────────────────────────
# STUDIO_PASSCODE=
