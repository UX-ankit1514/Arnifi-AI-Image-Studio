rules_version = '2';

// Image Studio talks to Firestore only from its own server (Admin SDK, which bypasses these rules).
// Browsers and other apps get no direct access: internal images stay private (PRD §18.3, §21.4).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
