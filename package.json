{
  "name": "arnifi-image-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Arnifi Image Studio \u2014 find, generate, edit and reuse Arnifi images in one internal workspace.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3109",
    "dev:emulator": "firebase emulators:exec --only firestore --project demo-image-studio \"next dev -H 127.0.0.1 -p 3109\"",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3109",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "firebase emulators:exec --config firebase.test.json --only firestore --project demo-image-studio \"vitest run --project integration\"",
    "test:e2e": "playwright test",
    "test:live": "tsx --conditions=react-server scripts/live-check.ts",
    "seed": "tsx --conditions=react-server scripts/seed.ts",
    "firebase": "firebase",
    "helper": "tsx --conditions=react-server scripts/helper.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "firebase-tools": "^15.34.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
